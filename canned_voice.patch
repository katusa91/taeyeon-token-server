+def _canned_save_file(key: str, pcm: bytes):
+    """합성한 안내 음성을 voice_notes/<이름>.wav(+문장 .txt)로 저장한다. 다음에 서버가 떠도 API를 부르지 않고 이 파일을 쓴다."""
+    try:
+        import wave
+        os.makedirs(CANNED_VOICE_DIR, exist_ok=True)
+        with wave.open(os.path.join(CANNED_VOICE_DIR, key + ".wav"), "wb") as w:
+            w.setnchannels(1)
+            w.setsampwidth(2)
+            w.setframerate(24000)
+            w.writeframes(pcm)
+        with open(os.path.join(CANNED_VOICE_DIR, key + ".txt"), "w", encoding="utf-8") as tf:
+            tf.write(CANNED_TEXTS[key])
+        logging.info("음성 안내 파일 저장: %s/%s.wav", CANNED_VOICE_DIR, key)
+    except Exception as e:
