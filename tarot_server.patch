+    h = hashlib.sha256(("%s|%s|tarot" % (day, OWNER_USER_ID if OWNER_USER_ID is not None else "owner")).encode("utf-8")).digest()
+    c = _TAROT_DECK[int.from_bytes(h[:4], "big") % len(_TAROT_DECK)]
+    rev = bool(h[4] & 1)
+    with _tarot_lock:
+        again = _tarot_state["day"] == day and _tarot_state["count"] > 0
+        _tarot_state.update(day=day, count=(_tarot_state["count"] + 1) if again else 1)
+    meaning = c["rev"] if rev else c["up"]
