+def _tarot_build_deck():
+    deck = [{"ko": ko, "en": en, "up": up, "rev": rv, "label": "MAJOR " + _TAROT_ROMAN[i], "symbol": "✨", "area": ""}
+            for i, (ko, en, up, rv) in enumerate(_TAROT_MAJOR)]
+    for sko, sen, sym, area in _TAROT_SUITS:
+        for rko, ren, up, rv in _TAROT_RANKS:
+            deck.append({"ko": "%s %s" % (sko, rko), "en": "%s of %s" % (ren, sen), "up": up, "rev": rv,
+                         "label": sen.upper() + " " + (rko if rko.isdigit() else ren.upper()), "symbol": sym, "area": "%s(%s)" % (area, sko)})
+    return deck
+
