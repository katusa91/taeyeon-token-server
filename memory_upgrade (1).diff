+def _keyword_stems(text):
+    stems = set()
+    for w in re.findall(r"[가-힣A-Za-z0-9]{2,}", text or ""):
+        st = w[:-1] if len(w) >= 3 and w[-1] in _KO_PARTICLES else w
+        if len(st) >= 2 and st not in _MOMENT_STOP:
+            stems.add(st.lower())
+    return stems
+
