+def select_moments_for_prompt(moments, recent_texts, total=_MOMENT_TOTAL, fixed=_MOMENT_NEWEST_FIXED):
+    """moments: (id/topic.. 순서는 build_memorable_context와 동일한 행, 최신순). 최신 `fixed`건은 무조건 싣고,
+    나머지 자리는 '최근 대화에 나온 단어와 겹치는 옛 기억'으로 채운다. 겹치는 게 없으면 그냥 최신순으로 채운다.
+    (토큰 발급 시점에는 사용자 발화가 아직 없으므로 임베딩 대신 직전 대화 텍스트로 단순 키워드 매칭만 한다.)"""
+    moments = list(moments or [])
+    if len(moments) <= total:
+        return moments
+    hint = " ".join(t for t in (recent_texts or []) if isinstance(t, str)).lower()
+    cand = []
+    if hint:
+        for i in range(fixed, len(moments)):
+            m = moments[i]
+            stems = _keyword_stems(f"{m[1]} {m[2]}")
+            score = sum(1 for st in stems if st in hint)
+            if score > 0:
+                cand.append((-score, i))
+    cand.sort()
+    extra = [i for _, i in cand[: total - fixed]]
+    taken = set(extra)
+    for i in range(fixed, len(moments)):
+        if len(extra) >= total - fixed:
+            break
+        if i not in taken:
+            extra.append(i)
+            taken.add(i)
+    return [moments[i] for i in sorted(list(range(fixed)) + extra)]
+
