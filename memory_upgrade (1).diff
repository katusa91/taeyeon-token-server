+    wk = ["월", "화", "수", "목", "금", "토", "일"]
+    lines, used = [], 0
+    for d, text in sorted(rows, key=lambda x: x[0], reverse=True):  # 최신부터 예산을 채운다
+        if d >= today or not text:
+            continue
+        line = f"- {d.month}월 {d.day}일({wk[d.weekday()]}, {(today - d).days}일 전) {text[:_DAILY_ENTRY_MAX_CHARS]}"
+        if used + len(line) > _DAILY_TOTAL_MAX_CHARS:
+            break
+        lines.append(line)
